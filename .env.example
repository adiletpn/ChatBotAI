# ============================================================
#  Mind AI — настройки. Скопируйте файл в .env и заполните.
# ============================================================

# --- Языковая модель (LLM) ---------------------------------
# Протокол API:
#   openai    — любой OpenAI-совместимый API (/v1/chat/completions):
#               xKiro / kiro-прокси, OpenRouter, Groq, Together, Ollama, LM Studio, OpenAI ...
#   anthropic — Anthropic-совместимый API (/v1/messages)
LLM_PROVIDER=openai

# Базовый адрес API (без /chat/completions на конце). Пример для xKiro —
# подставьте адрес, который выдаёт ваш сервис:
LLM_BASE_URL=https://api.xkiro.com/v1

# Ключ API. Пусто = бот работает в офлайн-режиме (извлекающие ответы без LLM).
# Если ваш прокси не требует ключ — впишите любое значение, например: none
LLM_API_KEY=

# Имя модели, которое понимает ваш API
LLM_MODEL=qwen/qwen3.7-max:free

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=120

# Перевод запроса на kk/ru/en для поиска (вопрос на русском — документ на казахском)
QUERY_EXPANSION=true

# Распознавание сканов через модель с поддержкой изображений,
# если Tesseract не установлен (модель должна поддерживать vision)
VISION_OCR=false

# Mind Pro — модель со «зрением»: видит страницы PDF (таблицы, графики, схемы) при ответе
VISION_MODEL=qwen/qwen3-vl-plus:free
PRO_PAGES=3

# Семантический поиск (эмбеддинги) — локальная модель в дополнение к поиску по словам.
# Модель (~220 МБ) скачивается при первом запуске в DATA_DIR/models. false — только BM25.
SEMANTIC_SEARCH=true

# --- Лимиты бесплатного тарифа (на пользователя в сутки, по времени Казахстана) ---
FREE_DAILY_QUESTIONS=20
FREE_DAILY_GENERATIONS=10
# Бессмысленные запросы («р», «фывфыв»): после стольких за сутки вопросы блокируются на 24 часа
JUNK_BLOCK_AFTER=5

# --- Почта для кодов подтверждения и сброса пароля ----------
# Gmail: включите 2FA и создайте «пароль приложения» на myaccount.google.com/apppasswords
# Без SMTP коды печатаются в консоль сервера (режим разработки).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mind AI <ваш@gmail.com>

# Firebase Authentication — вход через Google, подтверждение почты и сброс пароля письмами от Firebase.
# Значения из Firebase Console → Project settings → Your apps → Web (firebaseConfig). Ключи публичные.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Brevo (brevo.com) — отправка писем по HTTP. Нужна на Railway: там исходящий SMTP закрыт.
# Если задан ключ, используется вместо SMTP. Отправитель (SMTP_FROM) должен быть подтверждён в Brevo.
BREVO_API_KEY=

# --- Telegram (необязательно) -------------------------------
# Токен от @BotFather. Если задан — Telegram-бот запускается вместе с сервером.
TELEGRAM_BOT_TOKEN=

# --- Сервер -------------------------------------------------
HOST=0.0.0.0
PORT=8000
